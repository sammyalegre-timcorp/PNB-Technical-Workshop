rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /poll_config/{configId} {
      allow get: if isValidId(configId);
      allow list: if true;
      allow write: if isValidId(configId)
        && request.resource.data.title is string && request.resource.data.title.size() <= 200
        && request.resource.data.purpose is string && request.resource.data.purpose.size() <= 200
        && request.resource.data.dates is list;
    }

    match /votes/{voteId} {
      allow get: if isValidId(voteId);
      allow list: if true;
      allow create: if isValidId(voteId)
        && (request.resource.data.selectedDateIds is list || request.resource.data.availability is map);
      allow update: if isValidId(voteId)
        && (request.resource.data.selectedDateIds is list || request.resource.data.availability is map);
      allow delete: if isValidId(voteId);
    }
  }
}
